# Local warehouse trial (copy to .env, never commit .env)
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
LOCAL_TRIAL=true
VITE_LOCAL_TRIAL=true
SQL_DRIVER=pglite
PGLITE_DATA_DIR=runtime/database
# Generate a unique value before using backup/stop endpoints:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCAL_STOP_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
# Optional Gemini integration
GEMINI_API_KEY=
# Firebase Google sign-in still requires the application's existing Firebase
# configuration and localhost in Authentication > Settings > Authorized domains.
# For PostgreSQL/Cloud SQL set SQL_DRIVER=postgres and configure SQL_HOST,
# SQL_PORT, SQL_USER, SQL_PASSWORD and SQL_DB_NAME. Never commit real credentials.
# Supabase/managed PostgreSQL production settings:
# SQL_SSL=true
# SQL_SSL_REJECT_UNAUTHORIZED=true
# RUN_DB_MIGRATIONS=true
